               "beat", "surge", "surged", "expansion", "dividend", "recovery", "robust", "outperform"],
  "negative": ["loss", "losses", "lower", "decline", "declined", "decrease", "decreased", "weak", "weaker", "fall",
               "fell", "drop", "dropped", "downgrade", "downgraded", "default", "fraud", "lawsuit", "penalty",
               "miss", "missed", "slump", "slumped", "deficit", "impairment", "probe", "suspended", "underperform"],
  "negators": ["not", "no", "never", "without", "neither", "nor", "hardly"],
  "intensifiers": {"very": 1.5, "sharply": 1.5, "significantly": 1.5, "strongly": 1.5, "slightly": 0.5,
                   "marginally": 0.5}
