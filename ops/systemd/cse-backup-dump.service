# CSE P1: local PostgreSQL dump (pg_dump from an exported snapshot + manifest). Records ops.backup_runs.
[Unit]
Description=CSE local PostgreSQL dump (P1 backup)
Wants=postgresql.service
After=postgresql.service local-fs.target
RequiresMountsFor=/srv/cse-backup

[Service]
Type=oneshot
User=cse-backup
Group=cse-backup
EnvironmentFile=/etc/cse/cse.env
EnvironmentFile=-/etc/cse/backup.env
Environment="PYTHONPATH=/opt/cse/app" "CSE_DB_USER=cse_backup"
WorkingDirectory=/opt/cse/app
ExecStart=/usr/bin/python3 -m worker.ops.backup dump
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/cse-backup
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
