#!/usr/bin/env bash
# Run the CSE P2 market capture as its service user (OS cse-worker -> PostgreSQL cse_worker by peer authentication)
# with the server configuration loaded. Never as root, never as postgres. P2 is MANUAL: there is no capture timer
# (P3 decides scheduling and go-live). G-1: owner-accepted risk, NOT CSE authorization - see
# docs/governance/G-1_CSE_DATA_USE.md and docs/ops/P2_MARKET_CAPTURE.md before using the commands that contact CSE.
#
#   sudo bash /opt/cse/app/ops/bin/cse-capture capture --trading-date 2026-09-28 --mode post_close
#   sudo bash /opt/cse/app/ops/bin/cse-capture status --trading-date 2026-09-28
#   sudo bash /opt/cse/app/ops/bin/cse-capture recover | resume --run-id UUID | reprocess --run-id UUID
#   sudo bash /opt/cse/app/ops/bin/cse-capture protection --run-id UUID      # dimension F, read-only as cse-backup
set -euo pipefail
APP="${CSE_APP_DIR:-/opt/cse/app}"
[[ $# -ge 1 ]] || { echo "usage: $0 <command> [args...]  (python -m worker.market_capture --help)" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 2; }
user=cse-worker; role=cse_worker
if [[ "$1" == "protection" ]]; then            # the backup role can read P1's ops.backup_runs; status is read-only
  shift; set -- status "$@"; user=cse-backup; role=cse_backup
fi
exec runuser -u "$user" -- bash -c '
  set -a
  . /etc/cse/cse.env
  if [ -r /etc/cse/capture.env ]; then . /etc/cse/capture.env; fi
  set +a
  export PYTHONPATH="$0" CSE_DB_USER="$1"
  shift 1
  cd /
  exec python3 -m worker.market_capture "$@"' "$APP" "$role" "$@"
