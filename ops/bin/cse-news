#!/usr/bin/env bash
# Run the news-sentiment command line (Phase 6, docs/PHASE6_NEWS_SENTIMENT_DESIGN.md) with the server configuration
# loaded. Never as root, never as postgres. No network: v1 has no ingest command, and no source exists until the
# owner registers one with its governance record (P6-R1).
#
# Who runs what (all reached only through sudo, i.e. by root/the owner):
#   preflight, status, verify       OS cse-worker   -> PostgreSQL cse_worker (peer)
#   register-source, start-ingestion, clear-stop, alias, end-alias, declare-archive, designate (owner)
#                                   OS cse-migrator -> PostgreSQL cse_migrator, acting as cse_owner - the owner path
#
#   sudo bash /opt/cse/app/ops/bin/cse-news preflight
#   sudo bash /opt/cse/app/ops/bin/cse-news register-source --record /path/NS-SOURCE.md --ref NS-SOURCE.md
set -euo pipefail
APP="${CSE_APP_DIR:-/opt/cse/app}"
[[ $# -ge 1 ]] || { echo "usage: $0 <command> [args...]  (python -m worker.news_store --help)" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 2; }
user=cse-worker; role=cse_worker
case "$1" in
  register-source|start-ingestion|clear-stop|alias|end-alias|declare-archive|designate|stop-source|purge-source) user=cse-migrator; role=cse_migrator ;;
esac
operator="${SUDO_USER:-root}"                   # the human who ran sudo, recorded on an owner decision
exec runuser -u "$user" -- bash -c '
  set -a
  . /etc/cse/cse.env
  set +a
  export PYTHONPATH="$0" CSE_DB_USER="$1" CSE_OPERATOR="$2"
  shift 2
  cd /
  exec python3 -m worker.news_store "$@"' "$APP" "$role" "$operator" "$@"
