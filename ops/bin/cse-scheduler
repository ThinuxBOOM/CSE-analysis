#!/usr/bin/env bash
# Run the CSE P3 capture scheduler command line with the server configuration loaded. Never as root, never as postgres.
# systemd runs `run` by itself (cse-capture-scheduler.timer); this wrapper is for the operator. G-1: owner-accepted
# risk, NOT CSE authorization - see docs/governance/G-1_CSE_DATA_USE.md and docs/ops/P3_SCHEDULER.md.
#
# Who runs what (all reached only through sudo, i.e. by root/the owner):
#   every scheduler command          OS cse-worker   -> PostgreSQL cse_worker (peer) - the capture worker
#   arm / disarm (owner decisions)   OS cse-migrator -> PostgreSQL cse_migrator, acting as cse_owner for ONE insert -
#                                    the owner path; the capture worker can never arm or disarm itself
#
#   sudo bash /opt/cse/app/ops/bin/cse-scheduler status
#   sudo bash /opt/cse/app/ops/bin/cse-scheduler list --state missed failed blocked abandoned
#   sudo bash /opt/cse/app/ops/bin/cse-scheduler retry --trading-date 2026-10-01 --reason "network outage fixed"
#   sudo bash /opt/cse/app/ops/bin/cse-scheduler arm ...        (the release gate: docs/ops/P3_SCHEDULER.md)
set -euo pipefail
APP="${CSE_APP_DIR:-/opt/cse/app}"
[[ $# -ge 1 ]] || { echo "usage: $0 <command> [args...]  (python -m worker.scheduler --help)" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 2; }
user=cse-worker; role=cse_worker
case "$1" in
  arm|disarm) user=cse-migrator; role=cse_migrator ;;
esac
operator="${SUDO_USER:-root}"                   # the human who ran sudo, recorded on an owner decision
exec runuser -u "$user" -- bash -c '
  set -a
  . /etc/cse/cse.env
  if [ -r /etc/cse/capture.env ]; then . /etc/cse/capture.env; fi
  set +a
  export PYTHONPATH="$0" CSE_DB_USER="$1" CSE_OPERATOR="$2"
  shift 2
  cd /
  exec python3 -m worker.scheduler "$@"' "$APP" "$role" "$operator" "$@"
