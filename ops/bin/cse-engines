#!/usr/bin/env bash
# Run the F7 / DE command line (Phase 4, docs/PHASE4_DETERMINISTIC_ENGINES_DESIGN.md section 10) with the server
# configuration loaded. Never as root, never as postgres. No network, no CSE request: F7 and DE read only what is
# already in PostgreSQL (MF snapshots, F8 evidence, issuer links).
#
# Who runs what (all reached only through sudo, i.e. by root/the owner):
#   every command        OS cse-worker   -> PostgreSQL cse_worker (peer)
#   designate (owner)    OS cse-migrator -> PostgreSQL cse_migrator, acting as cse_owner - the owner path
#
#   sudo bash /opt/cse/app/ops/bin/cse-engines preflight
#   sudo bash /opt/cse/app/ops/bin/cse-engines run --snapshot 42
#   sudo bash /opt/cse/app/ops/bin/cse-engines verify
set -euo pipefail
APP="${CSE_APP_DIR:-/opt/cse/app}"
[[ $# -ge 1 ]] || { echo "usage: $0 <command> [args...]  (python -m worker.feature_engine_store --help)" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 2; }
user=cse-worker; role=cse_worker
case "$1" in
  designate) user=cse-migrator; role=cse_migrator ;;
esac
operator="${SUDO_USER:-root}"                   # the human who ran sudo, recorded on an owner decision
exec runuser -u "$user" -- bash -c '
  set -a
  . /etc/cse/cse.env
  set +a
  export PYTHONPATH="$0" CSE_DB_USER="$1" CSE_OPERATOR="$2"
  shift 2
  cd /
  exec python3 -m worker.feature_engine_store "$@"' "$APP" "$role" "$operator" "$@"
