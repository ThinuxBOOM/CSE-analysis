# /etc/cse/capture.env - P2 market capture settings (root:cse-worker 0640). Installed by hand (docs/ops/P2_MARKET_CAPTURE.md).
# Nothing here is secret, but the real contact address belongs on the server only: never commit it to the repository.

# G-1 control 4: an identifiable User-Agent carrying a contact e-mail. REQUIRED by every command that contacts CSE
# (capture, sweep, resume); they refuse to start without a valid address.
CSE_CAPTURE_CONTACT_EMAIL=

# G-1 control 2: minimum seconds between consecutive CSE requests. May be raised; anything below 1.5 is refused.
CSE_CAPTURE_MIN_INTERVAL_SECONDS=1.5
