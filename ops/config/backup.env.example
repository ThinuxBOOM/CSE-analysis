# /etc/cse/backup.env - backup settings (root:cse-backup 0640). Installed by provisioning if absent.
# It holds PATHS to credential files only; the credential files themselves live in /etc/cse/credentials
# (root:cse-backup, 0640 files / 0750 directory) and are never committed, logged or copied.
#
# Off-site backup stays 'disabled' until the owner chooses a destination and key custodian. While disabled,
# every off-site run is recorded as 'not_configured' (never as success) and `backup status` raises an alert.
CSE_OFFSITE_MODE=disabled
#CSE_OFFSITE_MODE=restic
#CSE_OFFSITE_REPOSITORY_FILE=/etc/cse/credentials/offsite-repository
#CSE_OFFSITE_PASSWORD_FILE=/etc/cse/credentials/offsite-password
#CSE_OFFSITE_ENV_FILE=/etc/cse/credentials/offsite-backend.env

# Throwaway cluster used by the restore check (private socket, no TCP).
CSE_RESTORE_PORT=54329
# A backup run still 'running' after this many hours is closed as failed ('abandoned') by the next run.
CSE_STALE_RUN_HOURS=6
