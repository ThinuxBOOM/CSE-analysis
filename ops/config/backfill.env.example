# /etc/cse/backfill.env - Phase 2 backfill (HB-6) settings (root:cse-worker 0640). Installed by
# ops/provision/provision_backfill.sh if absent. Nothing here is secret; never commit a server's real copy.
# The contact e-mail for the User-Agent is P2's CSE_CAPTURE_CONTACT_EMAIL in /etc/cse/capture.env (G-1 control 4).

# Reports and the audit's per-filing table, OUTSIDE the repository (G-1 controls 7-8). The worker writes new files only.
CSE_BACKFILL_REPORT_DIR=/var/lib/cse-backfill/reports

# Optional: a path on the PostgreSQL data disk, so `status` can alert when its free space falls under 20 GiB.
CSE_BACKFILL_DB_DISK_PATH=

# The dedicated temporary root (HB-4) is set by the service unit (/tmp/cse-backfill inside its private /tmp) and by
# ops/bin/cse-backfill for manual runs; do not point it at a shared or persistent directory.
