# /etc/cse/cse.env - non-secret settings shared by CSE services (root:root 0644).
# Installed by ops/provision/provision.sh if absent; never put a password, token or key in this file.
CSE_DB_NAME=cse
CSE_DB_HOST=/var/run/postgresql
CSE_DB_PORT=5432
CSE_PG_BINDIR=/usr/lib/postgresql/17/bin
CSE_BACKUP_ROOT=/srv/cse-backup
