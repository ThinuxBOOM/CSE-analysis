# Wakes the P3 scheduler shortly after boot and every 15 minutes. It carries NO business schedule: which Colombo
# trading dates are due, their windows, retries and catch-up are decided from PostgreSQL on every wake-up. A firing
# missed while the server was off is therefore simply caught up by the next wake-up; correctness never depends on
# Persistent= (not used). Installing or enabling this timer contacts nobody: the scheduler stays disarmed until the
# owner records `arm`.
[Unit]
Description=CSE capture scheduler wake-ups (boot + every 15 minutes)

[Timer]
OnBootSec=3min
OnCalendar=*-*-* *:00/15:00
AccuracySec=30s

[Install]
WantedBy=timers.target
